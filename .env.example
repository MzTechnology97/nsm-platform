APP_NAME=Network Security Platform
APP_ENV=production
APP_TIMEZONE=Europe/Rome
DB_HOST=postgres
DB_PORT=5432
DB_USER=network_platform
DB_NAME=network_platform
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
SESSION_COOKIE_NAME=nsp_session
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=28800
# Inactivity after which a session ends (minutes, minimum 5).
SESSION_IDLE_MINUTES=120
BACKUP_STORAGE_ROOT=/data/backups/device-files
LOG_LEVEL=INFO
