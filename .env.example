APP_NAME=Network Security Platform
APP_ENV=production
APP_TIMEZONE=Europe/Rome
DB_HOST=postgres
DB_PORT=5432
DB_USER=network_platform
DB_NAME=network_platform
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
SESSION_COOKIE_NAME=nsp_session
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=28800
# Inactivity after which a session ends (minutes, minimum 5).
SESSION_IDLE_MINUTES=120
BACKUP_STORAGE_ROOT=/data/backups/device-files
LOG_LEVEL=INFO
# Integrated GenieACS (TR-069): set by ./manage.sh acs-enable.
# COMPOSE_PROFILES=acs
# GENIEACS_INTERNAL_NBI_URL=http://genieacs-nbi:7557

# Integrated syslog server (LOG-01): host port published for the devices (UDP and TCP).
# Open it on the firewall only toward your device networks.
# SYSLOG_HOST_PORT=514

# GenieACS panel published by Caddy behind the NSM administrator check (Amministrazione > ACS).
# ACS_UI_PORT=7080
# GENIEACS_UI_PUBLIC_URL=https://nsm.example.net:7080/

# Exposure check from the NSM server on the public IP of devices without the MikroTik Agent check
# (Esposizione tab). 0 disables it; the timeout is per port, in seconds.
# EXPOSURE_EXTERNAL_CHECK=1

# FTP upload receiver for RouterOS 6 / 7.12 backups (./manage.sh legacy-backup-enable <IPv4>).
# LEGACY_FTP_ENABLED=1
# LEGACY_FTP_PUBLIC_HOST=203.0.113.10
# LEGACY_FTP_PORT=2121
# EXPOSURE_EXTERNAL_TIMEOUT=2.0
