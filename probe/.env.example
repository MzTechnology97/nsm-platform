# Shared secret, at least 32 characters (e.g. `openssl rand -hex 32`): the same value goes in NSM.
PROBE_SECRET=
# Name shown in NSM next to the results.
PROBE_NAME=probe-1
# Public address(es) of the NSM server, comma separated: only they may call the probe. Empty = anyone with the secret.
PROBE_ALLOWED_SOURCES=
PROBE_PORT=8788
PROBE_MAX_REQUESTS=30
