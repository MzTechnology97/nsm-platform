[Unit]
Description=NSM Platform automatic validated deployment
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/default/nsm-auto-update
ExecStart=/usr/local/sbin/nsm-auto-update
TimeoutStartSec=20min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true

[Install]
WantedBy=multi-user.target
