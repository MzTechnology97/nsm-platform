{
	admin off
}

:80 {
	encode zstd gzip
	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		X-Permitted-Cross-Domain-Policies "none"
		Content-Security-Policy "default-src 'self'; style-src 'self'; img-src 'self' data:; form-action 'self'; frame-ancestors 'none'; base-uri 'self'"
	}
	reverse_proxy api:8000 {
		health_uri /health
		health_interval 15s
		health_timeout 3s
	}
}

# GenieACS panel (TR-069 ACS), opened from NSM > Amministrazione > ACS.
# Only NSM administrators get through (forward_auth); GenieACS keeps its own login.
# With HTTPS replace ":7080" with "<nome-dns>:7080" so Caddy serves it with the same certificate.
:7080 {
	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
	}
	forward_auth api:8000 {
		uri /internal/acs-ui/auth
	}
	reverse_proxy genieacs-ui:3000
}
